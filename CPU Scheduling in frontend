        quantum = self.quantum_spin.value()
        self.all_results = {
            "FCFS": self.fcfs_scheduling(),
            "SJF (NP)": self.sjf_scheduling(preemptive=False),
            "SJF (P)": self.sjf_scheduling(preemptive=True),
            "RR": self.round_robin_scheduling(quantum),
            "Priority (NP)": self.priority_scheduling(preemptive=False),
            "Priority (P)": self.priority_scheduling(preemptive=True)
        }
        
        compare_dialog = QDialog(self)
        compare_dialog.setWindowTitle("Algorithm Comparison")
        compare_dialog.resize(1200, 800)
        layout = QVBoxLayout(compare_dialog)
        
        # Tabs for detailed results
        tab_widget = QTabWidget()
        for algo, result in self.all_results.items():
            tab = QWidget()
            tab_layout = QVBoxLayout(tab)
            
            table = QTableWidget()
            table.setColumnCount(8)
            table.setHorizontalHeaderLabels(["PID", "Name", "Arrival", "Burst", "Priority", "Completion", "Turnaround", "Waiting"])
            table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
            table.setRowCount(len(result.processes))
            for i, p in enumerate(result.processes):
                table.setItem(i, 0, QTableWidgetItem(str(p.pid)))
                table.setItem(i, 1, QTableWidgetItem(p.name))
                table.setItem(i, 2, QTableWidgetItem(str(p.arrival_time)))
                table.setItem(i, 3, QTableWidgetItem(str(p.burst_time)))
                table.setItem(i, 4, QTableWidgetItem(str(p.priority)))
                table.setItem(i, 5, QTableWidgetItem(str(p.completion_time)))
                table.setItem(i, 6, QTableWidgetItem(str(p.turnaround_time)))
                table.setItem(i, 7, QTableWidgetItem(str(p.waiting_time)))
            tab_layout.addWidget(table)
            
            metrics = QLabel(f"Avg Turnaround: {result.avg_turnaround:.2f} | Avg Waiting: {result.avg_waiting:.2f} | Throughput: {result.throughput:.2f}")
            tab_layout.addWidget(metrics)
            
            gantt_btn = QPushButton("Show Gantt Chart")
            gantt_btn.clicked.connect(lambda _, r=result, a=algo: self.plot_gantt_chart(r, f"{a} Gantt Chart"))
            tab_layout.addWidget(gantt_btn)
            
            tab_widget.addTab(tab, algo)
        
        layout.addWidget(tab_widget)

        # Pie Charts for Comparison
        pie_widget = QWidget()
        pie_layout = QHBoxLayout(pie_widget)
        
        # Turnaround Time Pie Chart
        turnaround_fig = Figure(figsize=(5, 5))
        turnaround_canvas = FigureCanvas(turnaround_fig)
        ax1 = turnaround_fig.add_subplot(111)
        turnaround_times = [result.avg_turnaround for result in self.all_results.values()]
        best_algo_tat = min(self.all_results.items(), key=lambda x: x[1].avg_turnaround)[0]
        ax1.pie(turnaround_times, labels=self.all_results.keys(), autopct='%1.1f%%', startangle=90)
        ax1.set_title(f"Turnaround Time\nBest: {best_algo_tat}")
        turnaround_fig.tight_layout()
        pie_layout.addWidget(turnaround_canvas)

        # Waiting Time Pie Chart
        waiting_fig = Figure(figsize=(5, 5))
        waiting_canvas = FigureCanvas(waiting_fig)
        ax2 = waiting_fig.add_subplot(111)
        waiting_times = [result.avg_waiting for result in self.all_results.values()]
        best_algo_wt = min(self.all_results.items(), key=lambda x: x[1].avg_waiting)[0]
        ax2.pie(waiting_times, labels=self.all_results.keys(), autopct='%1.1f%%', startangle=90)
        ax2.set_title(f"Waiting Time\nBest: {best_algo_wt}")
