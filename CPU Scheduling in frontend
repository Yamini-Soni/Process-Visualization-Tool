    def clean_gantt_chart(self, gantt):
        if not gantt:
            return gantt
        cleaned_gantt = []
        current_pid, current_start, current_end = gantt[0]
        for pid, start, end in gantt[1:]:
            if pid == current_pid and start == current_end:
                current_end = end
            else:
                cleaned_gantt.append((current_pid, current_start, current_end))
                current_pid, current_start, current_end = pid, start, end
        cleaned_gantt.append((current_pid, current_start, current_end))
        return cleaned_gantt
        
    def show_gantt_chart(self):
        if not self.result:
            return
        self.plot_gantt_chart(self.result, "Gantt Chart")
        
    def plot_gantt_chart(self, result, title):
        gantt_dialog = QDialog(self)
        gantt_dialog.setWindowTitle(title)
        gantt_dialog.resize(1000, 500)
        layout = QVBoxLayout(gantt_dialog)
        
        figure = Figure(figsize=(12, 6), dpi=100)
        canvas = FigureCanvas(figure)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(canvas)
        layout.addWidget(scroll)
        
        ax = figure.add_subplot(111)
        if not result.gantt_chart:
            ax.text(0.5, 0.5, 'No Gantt chart data', ha='center', va='center')
        else:
            colors = plt.cm.get_cmap('tab20', len(result.processes))
            pid_to_color = {p.pid: colors(i) for i, p in enumerate(result.processes)}
            max_time = max(end for _, _, end in result.gantt_chart)
            y_pos = 0
            for pid, start, end in result.gantt_chart:
                ax.broken_barh([(start, end - start)], (y_pos - 0.4, 0.8), facecolors=pid_to_color[pid])
                ax.text((start + end) / 2, y_pos, f"P{pid}", ha='center', va='center', color='white')
                y_pos += 1
            ax.set_yticks(range(len(result.gantt_chart)))
            ax.set_yticklabels([f"P{pid}" for pid, _, _ in result.gantt_chart])
            ax.set_xlabel('Time')
            ax.set_ylabel('Processes')
            ax.set_title(title)
            ax.grid(True)
            ax.set_xlim(0, max_time * 1.1)
        figure.tight_layout()
        canvas.draw()
        gantt_dialog.exec()

