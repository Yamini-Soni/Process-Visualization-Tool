    def generate_processes(self):
        system_processes = [proc for proc in psutil.process_iter(['pid', 'name', 'cpu_percent']) if proc.info['cpu_percent'] > 0]
        if len(system_processes) < 5:
            self.processes = [
                Process(101, "System", 0, 5),
                Process(102, "Browser", 1, 7),
                Process(103, "Editor", 2, 3),
                Process(104, "Terminal", 3, 4),
                Process(105, "Media", 4, 6)
            ]
        else:
            self.processes = [
                Process(proc.info['pid'], str(proc.info['name'])[:15], i, random.randint(2, 10), random.randint(1, 5))
                for i, proc in enumerate(random.sample(system_processes, min(8, len(system_processes))))
            ]
        self.run_btn.setEnabled(True)
        self.compare_btn.setEnabled(True)
        
    def update_process_table(self, processes):
        self.process_table.setRowCount(len(processes))
        for i, process in enumerate(processes):
            self.process_table.setItem(i, 0, QTableWidgetItem(str(process.pid)))
            self.process_table.setItem(i, 1, QTableWidgetItem(process.name))
            self.process_table.setItem(i, 2, QTableWidgetItem(str(process.arrival_time)))
            self.process_table.setItem(i, 3, QTableWidgetItem(str(process.burst_time)))
            self.process_table.setItem(i, 4, QTableWidgetItem(str(process.priority)))
            self.process_table.setItem(i, 5, QTableWidgetItem(str(process.completion_time)))
            self.process_table.setItem(i, 6, QTableWidgetItem(str(process.turnaround_time)))
            self.process_table.setItem(i, 7, QTableWidgetItem(str(process.waiting_time)))
        
    def run_scheduling(self):
        self.generate_processes()
        algorithm = self.algorithm_combo.currentText()
        is_preemptive = self.preemptive_check.isChecked()
        quantum = self.quantum_spin.value()
        
        self.run_btn.setEnabled(False)
        try:
            if "FCFS" in algorithm:
                self.result = self.fcfs_scheduling()
            elif "SJF" in algorithm:
                self.result = self.sjf_scheduling(preemptive=is_preemptive)
            elif "Round Robin" in algorithm:
                self.result = self.round_robin_scheduling(quantum)
            elif "Priority" in algorithm:
                self.result = self.priority_scheduling(preemptive=is_preemptive)
            self.display_results(self.result)
        finally:
            self.run_btn.setEnabled(True)
        
    def fcfs_scheduling(self):
        result = SchedulingResult()
        processes = sorted(self.processes, key=lambda x: x.arrival_time)
        current_time = 0
        gantt = []
        for process in processes:
            current_time = max(current_time, process.arrival_time)
            process.completion_time = current_time + process.burst_time
            process.turnaround_time = process.completion_time - process.arrival_time
            process.waiting_time = process.turnaround_time - process.burst_time
            gantt.append((process.pid, current_time, process.completion_time))
            current_time = process.completion_time
        result.processes = processes
        result.gantt_chart = gantt
        result.avg_turnaround = sum(p.turnaround_time for p in processes) / len(processes)
        result.avg_waiting = sum(p.waiting_time for p in processes) / len(processes)
        result.throughput = len(processes) / current_time if current_time > 0 else 0
        return result
        
    def sjf_scheduling(self, preemptive=False):
        result = SchedulingResult()
        processes = sorted(self.processes, key=lambda x: x.arrival_time)
        current_time = 0
        gantt = []
        if not preemptive:
            ready_queue = []
            i = 0
            n = len(processes)
            while i < n or ready_queue:
                while i < n and processes[i].arrival_time <= current_time:
                    ready_queue.append(processes[i])
                    i += 1
                if not ready_queue:
                    if i < n:
                        current_time = processes[i].arrival_time
                    continue
                ready_queue.sort(key=lambda x: x.burst_time)
                process = ready_queue.pop(0)
                current_time = max(current_time, process.arrival_time)
                process.completion_time = current_time + process.burst_time
                process.turnaround_time = process.completion_time - process.arrival_time
                process.waiting_time = process.turnaround_time - process.burst_time
                gantt.append((process.pid, current_time, process.completion_time))
                current_time = process.completion_time
            result.processes = processes
        else:
            process_map = {p.pid: Process(p.pid, p.name, p.arrival_time, p.burst_time, p.priority) for p in processes}
            ready_queue = []
            i = 0
            n = len(processes)
            while i < n or any(p.remaining_time > 0 for p in process_map.values()):
                while i < n and processes[i].arrival_time <= current_time:
                    ready_queue.append(process_map[processes[i].pid])
                    i += 1
                if not ready_queue:
                    if i < n:
                        current_time = processes[i].arrival_time
                    continue
                ready_queue.sort(key=lambda x: x.remaining_time)
                process = ready_queue[0]
                if process.response_time == -1:
                    process.response_time = current_time - process.arrival_time
                gantt.append((process.pid, current_time, current_time + 1))
                process.remaining_time -= 1
                current_time += 1
                if process.remaining_time == 0:
                    process.completion_time = current_time
                    process.turnaround_time = process.completion_time - process.arrival_time
                    process.waiting_time = process.turnaround_time - process.burst_time
                    ready_queue.pop(0)
            result.processes = list(process_map.values())
        result.gantt_chart = self.clean_gantt_chart(gantt)
        result.avg_turnaround = sum(p.turnaround_time for p in result.processes) / len(result.processes)
        result.avg_waiting = sum(p.waiting_time for p in result.processes) / len(result.processes)
        result.throughput = len(result.processes) / current_time if current_time > 0 else 0
        return result
        
    def round_robin_scheduling(self, quantum):
        result = SchedulingResult()
        processes = sorted(self.processes, key=lambda x: x.arrival_time)
        current_time = 0
        gantt = []
        ready_queue = deque()
        remaining_processes = deque(processes.copy())
        while remaining_processes or ready_queue:
            while remaining_processes and remaining_processes[0].arrival_time <= current_time:
                ready_queue.append(remaining_processes.popleft())
            if not ready_queue:
                if remaining_processes:
                    current_time = remaining_processes[0].arrival_time
                continue
            process = ready_queue.popleft()
            if process.response_time == -1:
                process.response_time = current_time - process.arrival_time
            exec_time = min(quantum, process.remaining_time)
            gantt.append((process.pid, current_time, current_time + exec_time))
            process.remaining_time -= exec_time
            current_time += exec_time
            while remaining_processes and remaining_processes[0].arrival_time <= current_time:
                ready_queue.append(remaining_processes.popleft())
            if process.remaining_time > 0:
                ready_queue.append(process)
            else:
                process.completion_time = current_time
                process.turnaround_time = process.completion_time - process.arrival_time
                process.waiting_time = process.turnaround_time - process.burst_time
        result.processes = processes
        result.gantt_chart = self.clean_gantt_chart(gantt)
        result.avg_turnaround = sum(p.turnaround_time for p in processes) / len(processes)
        result.avg_waiting = sum(p.waiting_time for p in processes) / len(processes)
        result.throughput = len(processes) / current_time if current_time > 0 else 0
        return result
        
